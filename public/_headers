# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Pages _headers file
#
# Pattern matching rules (Cloudflare Pages reads top → bottom, last match
# wins for the same header). The 2026 web-vitals signals from this file:
#   - Best Practices 100 / 100 requires:
#       * HTTPS enforced (HSTS)
#       * No deprecated APIs, no console errors
#       * CSP that blocks inline-script XSS without breaking the app
#   - Trust & credibility in the browser UI (lock icon, "secure"):
#       * X-Frame-Options / frame-ancestors
#       * X-Content-Type-Options
#       * Referrer-Policy
#       * Permissions-Policy that disables unused powerful APIs
# ─────────────────────────────────────────────────────────────────────────────

# ── Default policy for every route ──────────────────────────────────────────
/*
  # HTTPS — force TLS for one year, including subdomains. Browsers that
  # see this header refuse plain-HTTP connections.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # MIME-sniffing protection. Cloudflare CDN can sometimes misclassify
  # a response; this header tells the browser to trust our Content-Type.
  X-Content-Type-Options: nosniff

  # Clickjacking protection. We never legitimately render inside an iframe.
  X-Frame-Options: DENY

  # Referrer leakage. Send only the origin on cross-origin navigations.
  Referrer-Policy: strict-origin-when-cross-origin

  # Lock down browser features we don't use. Geolocation/camera/mic are
  # none of this site's business; turning them off shrinks the threat
  # surface and signals Best Practices.
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), display-capture=(), document-domain=(), encrypted-media=(), execution-while-not-rendered=(), execution-while-out-of-viewport=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(self), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()

  # A modest CSP. The site uses inline styles for some micro-interactions
  # (a few `<style>` tags in scene components) and an inline JSON-LD block
  # for schema.org. Google Fonts is the only external stylesheet origin.
  # Inline scripts in the head are the anti-flash RTL setter, the Clarity
  # analytics tag, and the Ko-fi widget — all kept via 'unsafe-inline'.
  # If we ever migrate those to a nonce-based CSP, drop 'unsafe-inline'
  # for script-src.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.clarity.ms https://storage.ko-fi.com https://*.ko-fi.com https://*.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-src https://*.ko-fi.com https://ko-fi.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

  # Cross-origin isolation hints — keep embedding controlled but allow
  # same-origin + Ko-fi iframe.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# ── Static assets — long-cache immutable ─────────────────────────────────────
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# ── Fonts — Cloudflare's edge serves these for a year ────────────────────────
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# ── The CV PDF — explicit content-type & inline-preview hint ────────────────
/Abir_Abbas_CV.pdf
  Content-Type: application/pdf
  Content-Disposition: inline
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=86400

# ── The /cv route handler also sets these — keep them consistent ────────────
/cv
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin